# Copy to .env and fill in. NEVER commit the real .env.
NODE_ENV=development
PORT=4000

# SQLite for local dev. Swap for Postgres in production:
#   DATABASE_URL="postgresql://user:pass@localhost:5432/buddyy?schema=public"
DATABASE_URL="file:./dev.db"

# Generate strong secrets, e.g.:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
ACCESS_TOKEN_SECRET="replace-with-a-long-random-string-at-least-32-chars"
ACCESS_TOKEN_TTL="15m"
REFRESH_TOKEN_TTL_DAYS=30

# Frontend origin (Vite dev server) — used for CORS + email links.
CLIENT_ORIGIN="http://localhost:5173"

# Set true in production (HTTPS) so the refresh cookie is Secure.
COOKIE_SECURE=false
# Cookie SameSite policy. Leave blank to auto-pick: "none" when COOKIE_SECURE=true
# (needed when the frontend and API are on different origins, e.g. Vercel + Render),
# otherwise "lax" for local dev. CSRF is enforced via an Origin allowlist.
# COOKIE_SAMESITE=none
# Public URL of the API (used to build absolute links in emails). Optional.
# APP_BASE_URL="https://api.yourdomain.com"

# --- Observability ---
LOG_LEVEL=info
# Optional error tracking. Set the DSN and run `npm i @sentry/node` to enable.
# SENTRY_DSN=

# --- Transactional email (Resend HTTP API; no SDK dependency) ---
# Without a key, verification/reset emails are printed to the server console (dev).
# Get a key at https://resend.com and verify a sending domain for MAIL_FROM.
RESEND_API_KEY=
MAIL_FROM="Buddyy <onboarding@resend.dev>"

# --- File storage ---
# local = disk (dev). s3 = any S3-compatible bucket (AWS S3, Cloudflare R2, B2).
STORAGE_BACKEND=local
# For s3 / R2:
# S3_BUCKET=buddyy-uploads
# S3_REGION=auto                 # AWS: us-east-1 etc.  R2/B2: auto
# S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com   # omit for AWS S3
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# --- AI providers ---
# LLM_PROVIDER:       auto | anthropic | gemini | ollama | dev
# EMBEDDING_PROVIDER: auto | voyage    | gemini | ollama | dev
# "auto" prefers a configured cloud provider, else the free dev fallback.
LLM_PROVIDER=gemini
EMBEDDING_PROVIDER=gemini

# Recommended — Google Gemini: fast, free tier. Key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-flash-lite-latest
GEMINI_EMBED_MODEL=gemini-embedding-001

# Paid alternatives: Anthropic Claude (chat) + Voyage AI (embeddings)
# ANTHROPIC_API_KEY=sk-ant-...
# VOYAGE_API_KEY=pa-...
LLM_MODEL=claude-opus-4-8
EMBEDDING_MODEL=voyage-3.5

# Free & local alternative: Ollama (https://ollama.com). Set providers to "ollama"
# and pull:  ollama pull llama3.2  &&  ollama pull nomic-embed-text
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=llama3.2
OLLAMA_EMBED_MODEL=nomic-embed-text

# --- ANAM talking avatar (optional; https://anam.ai) ---
# Without these the app still works — the avatar shows as an animated orb.
# Get a key + avatar/voice IDs from the Anam Lab dashboard.
ANAM_API_KEY=
ANAM_AVATAR_ID=
ANAM_VOICE_ID=
ANAM_PERSONA_NAME=Buddyy

# --- Spatius avatar (optional; https://spatius.ai) ---
# Bring-your-own audio: needs a separate TTS engine to produce PCM16 for the avatar.
# App ID + Avatar ID come from the Spatius Studio (app.spatius.ai); key stays server-side.
SPATIUS_API_KEY=
SPATIUS_APP_ID=
SPATIUS_AVATAR_ID=

# --- Piper TTS (self-hosted, free) — the avatar's voice for Spatius ---
# Download: https://github.com/rhasspy/piper/releases  +  a voice from
# https://huggingface.co/rhasspy/piper-voices (e.g. en_US-amy-medium = 22050 Hz).
# PIPER_SAMPLE_RATE must match the voice model (medium=22050, low=16000).
PIPER_BIN=
PIPER_MODEL=
PIPER_SAMPLE_RATE=22050
